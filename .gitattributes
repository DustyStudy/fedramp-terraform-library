# Normalize line endings to LF for all text files, regardless of what OS
# or editor a contributor is using. This prevents whitespace-only diffs
# from showing up as noise in PRs and commit history.
* text=auto eol=lf

*.tf       text eol=lf
*.tfvars   text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.sh       text eol=lf

# Never treat these as text
*.png binary
*.jpg binary
*.gif binary
