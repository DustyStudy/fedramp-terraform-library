# Local .terraform directories
**/.terraform/*

# Lock files: callers ignore a module's lock file, so modules/ doesn't
# commit one. The deployable root stacks do, so CI and adopters install
# provider builds whose checksums were reviewed.
.terraform.lock.hcl
!examples/**/.terraform.lock.hcl
!moderate/**/.terraform.lock.hcl
!high/**/.terraform.lock.hcl

# Terraform state files — may contain sensitive data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Real tfvars files are almost always environment/account-specific and
# often contain sensitive values — never commit them. The illustrative
# example files under high/example-tfvars/ are the deliberate exception.
*.tfvars
*.tfvars.json
!high/example-tfvars/*.tfvars

# Override files are used to override resources in a local dev workflow
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda zips built by archive_file at plan time
**/build/

# Python
__pycache__/
.pytest_cache/
.ruff_cache/

# CLI configuration files
.terraformrc
terraform.rc

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Saved plans can hold account IDs and sensitive values
*.tfplan

# Live proof inputs (hold account IDs)
probe-inputs.json
dataplane-inputs.json
proof/member/dataplane/db-client.zip
